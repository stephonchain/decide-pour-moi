# Captures automatiques des deux localisations, sur le grand iPhone :
# App Store Connect dérive lui-même les tailles plus petites du 6,9".
devices(["iPhone 16 Pro Max"])
languages(["fr-FR", "en-US"])

scheme("DecidePourMoi")
output_directory("./fastlane/screenshots")
clear_previous_screenshots(true)

# Barre d'état propre : 9:41, batterie pleine, réseau plein.
override_status_bar(true)

# Un échec dans une langue ne doit pas emporter l'autre : on veut toujours
# repartir avec le maximum de captures et la liste de ce qui a manqué.
stop_after_first_error(false)
