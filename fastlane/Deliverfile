app_identifier("com.stephonchain.decidepourmoi")

# On ne pousse que la fiche : le binaire part par Xcode (Archive).
skip_binary_upload(true)
skip_app_version_update(false)

precheck_include_in_app_purchases(false)

copyright("#{Time.now.year} Steve Rover")

primary_category("UTILITIES")
secondary_category("LIFESTYLE")

submit_for_review(false)

# Ce sont les planches habillées qui partent sur la fiche, pas les captures
# brutes : `fastlane captures` produit les deux, dans cet ordre.
screenshots_path("./fastlane/captures_habillees")

# Pas de question interactive en cas de différence : la vérité est ici.
force(true)

# Synchronisation plutôt que remplacement. `overwrite_screenshots` efface
# tout puis renvoie tout : si App Store Connect n'a pas fini de traiter les
# images quand deliver vérifie leur présence, il les croit perdues et
# renvoie le lot entier — chaque visuel se retrouve en double sur la fiche.
# En mode synchronisé, deliver compare les empreintes : il n'envoie que ce
# qui manque vraiment et retire de la fiche ce qui n'existe plus ici.
sync_screenshots(true)
