default_platform(:ios)

platform :ios do
  desc "Captures d'écran FR + EN sur simulateur, puis habillage (fastlane captures)"
  lane :captures do
    capture_screenshots
    habiller
  end

  desc "Habille les captures déjà prises : fond, titre, cadre (fastlane habiller)"
  lane :habiller do
    # Pillow dans un environnement isolé, à la racine du dépôt : rien
    # d'installé sur le système, et le même rendu d'une machine à l'autre.
    # `venv` est idempotent, donc pas de test d'existence à faire.
    sh("cd .. && python3 -m venv .venv_captures" \
       " && .venv_captures/bin/pip install --quiet --upgrade pillow" \
       " && .venv_captures/bin/python scripts/habiller_captures.py")
  end

  desc "Publie fiche + captures habillées vers App Store Connect (fastlane publier)"
  lane :publier do
    cle_asc
    deliver
  end

  desc "Publie uniquement les métadonnées, sans les captures"
  lane :publier_textes do
    cle_asc
    deliver(skip_screenshots: true)
  end

  private_lane :cle_asc do
    # Clé API App Store Connect (rôle App Manager suffit) :
    #   ASC_KEY_ID       identifiant de la clé (ex. 2X9R4HXF34)
    #   ASC_ISSUER_ID    issuer id de la page des clés
    #   ASC_KEY_PATH     chemin du fichier .p8 téléchargé
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
  end
end
