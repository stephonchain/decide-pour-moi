    "La section « Nos autres apps » est une liste embarquée dans l'application. Ouvrir un de ces liens vous emmène sur l'App Store, où les règles d'Apple s'appliquent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The “Our other apps” section is a list bundled inside the app. Opening one of these links takes you to the App Store, where Apple's rules apply."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La section « Nos autres apps » est une liste embarquée dans l'application. Ouvrir un de ces liens vous emmène sur l'App Store, où les règles d'Apple s'appliquent."
          }
        }
      }
    },
