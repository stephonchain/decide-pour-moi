    "L'app ne demande aucune inscription, n'utilise aucun outil de mesure d'audience et n'intègre aucune régie publicitaire tierce.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app requires no sign-up, uses no analytics tools and includes no third-party ad network."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app ne demande aucune inscription, n'utilise aucun outil de mesure d'audience et n'intègre aucune régie publicitaire tierce."
          }
        }
      }
    },
    "L'option tirée reste dans la roue.": {
      "extractionState": "manual",
      "localizations": {
